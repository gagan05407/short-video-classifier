# Python virtual environment
venv/
env/
.venv/
__pycache__/
*.py[cod]
*$py.class

# Node / Vite frontend
node_modules/
frontend/node_modules/
frontend/dist/
.eslintcache

# Temporary uploads and logs
backend/temp_uploads/*
!backend/temp_uploads/.gitkeep
*.log
*.tmp

# Large binary files (>100MB exceeds GitHub push limit)
