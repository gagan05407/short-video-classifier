backend/weights/*.pth
backend/weights/live/v*.pt

# Large raw video datasets (>3GB total videos)
backend/data/test_data/
backend/data/speech_data/
backend/data/corrupted_test/
TEST/

# OS specific files
.DS_Store
Thumbs.db
